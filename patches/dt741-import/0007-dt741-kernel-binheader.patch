@@ -1,5 +1,13 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
+# DT741 的 kernel 分区在标准 Legacy uImage 前有 0x1E0 字节厂商头。
+# 未知字段继承 kernel0 模板；长度、CRC 和 A/B 状态由专用步骤更新。
+define Build/dt741-binheader
+	python3 $(TOPDIR)/target/linux/sanechips/image/dt741-binheader.py \
+		--template $(TOPDIR)/target/linux/sanechips/image/dt741-kernel0-header.hex \
+		--slot a "$@"
+endef
+
 E2631_VENDOR_TEMPLATE := $(call qstrip,$(CONFIG_E2631_VENDOR_TEMPLATE))
 
 define Device/zte_zxhn-e2631
@@ -8,6 +16,6 @@ define Device/zte_zxhn-e2631
   DEVICE_DTS := zx279128s-zte-zxhn-e2631
   DEVICE_DTS_DIR := $(TOPDIR)/target/linux/sanechips/dts
   KERNEL_SIZE := 32768k
-  KERNEL := kernel-bin | append-dtb | uImage none | zte-slot-marker | \
+  KERNEL := kernel-bin | append-dtb | uImage none | dt741-binheader | \
 	check-size $$(KERNEL_SIZE)
   KERNEL_INITRAMFS := kernel-bin | append-dtb | uImage-ramboot
diff --git a/overlay/target/linux/sanechips/image/dt741-binheader.py b/overlay/target/linux/sanechips/image/dt741-binheader.py
new file mode 100644
--- /dev/null
+++ b/overlay/target/linux/sanechips/image/dt741-binheader.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""给 DT741 的 Legacy uImage 添加 0x1E0 字节厂商 binheader。"""
+
+import argparse
+import os
+from pathlib import Path
+import tempfile
+import zlib
+
+
+HEADER_SIZE = 0x1E0
+UIMAGE_HEADER_SIZE = 64
+UIMAGE_MAGIC = 0x27051956
+
+
+def fail(message):
+    raise SystemExit(f"dt741-binheader: {message}")
+
+
+def read_template(path):
+    try:
+        raw = "".join(Path(path).read_text(encoding="ascii").split())
+        header = bytearray.fromhex(raw)
+    except (OSError, UnicodeError, ValueError) as exc:
+        fail(f"无法读取 480B 模板 {path}: {exc}")
+    if len(header) != HEADER_SIZE:
+        fail(f"模板长度应为 0x{HEADER_SIZE:X} 字节，实际为 0x{len(header):X}")
+    if header[:16] != bytes.fromhex("999999994444444455555555aaaaaaaa"):
+        fail("模板厂商魔数不匹配")
+    if int.from_bytes(header[0x5C:0x60], "little") != HEADER_SIZE:
+        fail("模板 0x5C 不是固定的 0x1E0")
+    if header[0x128:0x12C] != b"\xFF" * 4:
+        fail("模板不是 kernel0/A 槽状态（0x128 应为 FFFFFFFF）")
+    # 原厂模板自带的 Header CRC 可独立复核，先确认模板没有被误改。
+    stored_crc = int.from_bytes(header[0x110:0x114], "little")
+    actual_crc = zlib.crc32(header[0x14:0x110]) & 0xFFFFFFFF
+    if stored_crc != actual_crc:
+        fail(f"模板 Header CRC 错误：存储 0x{stored_crc:08X}，计算 0x{actual_crc:08X}")
+    return header
+
+
+def verify_uimage(image):
+    if len(image) < UIMAGE_HEADER_SIZE:
+        fail("输入不足 64 字节，不是完整 Legacy uImage")
+    if int.from_bytes(image[0:4], "big") != UIMAGE_MAGIC:
+        fail("uImage magic 不匹配；要求标准 Legacy uImage，不能是 FIT")
+    if image[28:32] != bytes((5, 2, 2, 0)):
+        fail("uImage 必须是 Linux/ARM/Kernel/none 类型")
+
+    payload_size = int.from_bytes(image[12:16], "big")
+    if UIMAGE_HEADER_SIZE + payload_size != len(image):
+        fail(
+            "uImage ih_size 与输入文件长度不一致："
+            f"ih_size=0x{payload_size:X}, file=0x{len(image):X}"
+        )
+
+    # mkimage 已经生成这两个 CRC；这里独立复核，避免把坏 uImage 包进厂商头。
+    expected_hcrc = int.from_bytes(image[4:8], "big")
+    uimage_header = bytearray(image[:UIMAGE_HEADER_SIZE])
+    uimage_header[4:8] = b"\x00" * 4
+    actual_hcrc = zlib.crc32(uimage_header) & 0xFFFFFFFF
+    if actual_hcrc != expected_hcrc:
+        fail(f"Legacy uImage Header CRC 错误：存储 0x{expected_hcrc:08X}，计算 0x{actual_hcrc:08X}")
+
+    expected_dcrc = int.from_bytes(image[24:28], "big")
+    actual_dcrc = zlib.crc32(image[UIMAGE_HEADER_SIZE:]) & 0xFFFFFFFF
+    if actual_dcrc != expected_dcrc:
+        fail(f"Legacy uImage Data CRC 错误：存储 0x{expected_dcrc:08X}，计算 0x{actual_dcrc:08X}")
+
+
+def write_u32le(header, offset, value):
+    if not 0 <= value <= 0xFFFFFFFF:
+        fail(f"字段 0x{offset:X} 超出 32 位范围：0x{value:X}")
+    header[offset:offset + 4] = value.to_bytes(4, "little")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--template", required=True, help="kernel0 的 480 字节十六进制模板")
+    parser.add_argument("--slot", choices=("a", "b"), required=True, help="目标槽位")
+    parser.add_argument("image", help="mkimage 生成的 Legacy uImage；原地替换为 DT741 kernel image")
+    args = parser.parse_args()
+
+    image_path = Path(args.image)
+    try:
+        uimage = image_path.read_bytes()
+    except OSError as exc:
+        fail(f"无法读取 uImage {image_path}: {exc}")
+    verify_uimage(uimage)
+
+    header = read_template(args.template)
+    klen = len(uimage)  # 完整 uImage 长度，包含 64B Legacy Header。
+    end = HEADER_SIZE + klen
+    aligned_end = (end + 15) & ~15
+
+    # 以下偏移均为 DT741 binheader 内偏移，32 位字段采用小端存储。
+    write_u32le(header, 0x54, aligned_end)
+    write_u32le(header, 0x58, klen)
+    write_u32le(header, 0x5C, HEADER_SIZE)
+
+    # 0x60 覆盖整个 Legacy uImage（64B Header + Kernel Payload）。
+    write_u32le(header, 0x60, zlib.crc32(uimage) & 0xFFFFFFFF)
+    write_u32le(header, 0x68, aligned_end)
+
+    # A/B 原厂模板仅在此 4 字节状态值不同；首轮目标是 A 槽 kernel0。
+    header[0x128:0x12C] = b"\xFF" * 4 if args.slot == "a" else b"\x00" * 4
+
+    # 必须在更新 0x60 后计算；覆盖 [0x14, 0x110)，不包含 CRC 字段自身。
+    write_u32le(header, 0x110, zlib.crc32(header[0x14:0x110]) & 0xFFFFFFFF)
+
+    # 写入前再次验证动态字段，防止偏移或 CRC 顺序回归。
+    if int.from_bytes(header[0x58:0x5C], "little") != len(uimage):
+        fail("内部检查失败：0x58 长度字段不匹配")
+    if int.from_bytes(header[0x60:0x64], "little") != (zlib.crc32(uimage) & 0xFFFFFFFF):
+        fail("内部检查失败：0x60 Kernel CRC 不匹配")
+    if int.from_bytes(header[0x110:0x114], "little") != (zlib.crc32(header[0x14:0x110]) & 0xFFFFFFFF):
+        fail("内部检查失败：0x110 Header CRC 不匹配")
+
+    # 原子替换输入文件，避免中途失败留下半截 kernel 镜像。
+    output = bytes(header) + uimage
+    fd, temp_name = tempfile.mkstemp(prefix=image_path.name + ".", dir=str(image_path.parent))
+    try:
+        with os.fdopen(fd, "wb") as stream:
+            stream.write(output)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp_name, image_path)
+    except Exception:
+        try:
+            os.unlink(temp_name)
+        except FileNotFoundError:
+            pass
+        raise
+
+    print(
+        "DT741 binheader: "
+        f"slot={args.slot.upper()} header=0x{HEADER_SIZE:X} "
+        f"uImage=0x{klen:X} aligned_end=0x{aligned_end:X} "
+        f"kernel_crc=0x{int.from_bytes(header[0x60:0x64], 'little'):08X} "
+        f"header_crc=0x{int.from_bytes(header[0x110:0x114], 'little'):08X}"
+    )
+
+
+if __name__ == "__main__":
+    main()
